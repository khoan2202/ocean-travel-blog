# Chuỗi kết nối PostgreSQL.
# - Trên Vercel: cài Neon từ Marketplace (Storage) -> biến DATABASE_URL được tự động thêm.
# - Chạy local: copy file này thành .env rồi dán chuỗi kết nối Neon (hoặc Postgres local).
DATABASE_URL=postgres://user:password@host:5432/wanderwave

# Mật khẩu vào trang quản trị /admin (tự đặt, càng dài càng tốt)
ADMIN_KEY=doi-mat-khau-nay-nhe

# Cổng chạy dev-server local
PORT=3000
